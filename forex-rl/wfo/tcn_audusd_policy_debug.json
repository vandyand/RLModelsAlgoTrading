{
  "adapter": "tcn-action-eurusd-policy-debug",
  "adapter_spec": "wfo.adapters.tcn_nq_action:TCNActionNQAdapter",

  "start": "2024-01-01",
  "end": "2024-12-15",
  "train_n": 7.0,
  "val_n": 1.0,
  "step_n": 1.0,
  "unit": "weeks",
  "windows_limit": 8,

  "base_gran": "M15",
  "out_dir": "wfo/runs",

  "tcn_instrument": "AUD_USD",
  "grans": "M15,H1,D",
  "tcn_base_gran": "M15",

  "tcn_lookback": 128,
  "tcn_target_horizon": 24,
  "epochs": 3,
  "lr": 0.001,
  "tcn_hidden": 128,
  "tcn_kernel": 2,
  "tcn_blocks": 2,
  "tcn_dropout": 0.05,

  "mlp_layers": [128, 64],

  "label_long_thresh": 0.0007,
  "label_short_thresh": -0.0007,
  "label_mode": "bps",
  "label_long_quantile": 0.65,
  "label_short_quantile": 0.35,

  "tcn_trade_cost_bps": 1.0,

  "nq_enter_long": 0.035,
  "nq_exit_long": 0.03,
  "nq_enter_short": -0.035,
  "nq_exit_short": -0.03,

  "debug_force_all_long": false,

  "mode": "fast",
  "no_chart": false,
  "chart_every": 1,
  "quiet": false
}
